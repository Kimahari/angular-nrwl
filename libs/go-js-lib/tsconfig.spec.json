{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "NodeNext",
    "types": [
      "jest",
      "node"
    ],
    "target": "ES2016",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "emitDecoratorMetadata": false
  },
  "files": [
    "src/test-setup.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
