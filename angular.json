{
  "version": 1,
  "projects": {
    "some-app": {
      "projectType": "application",
      "schematics": {
        "@nx/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/some-app",
      "sourceRoot": "apps/some-app/src",
      "prefix": "myworkspace",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/apps/some-app",
            "index": "apps/some-app/src/index.html",
            "main": "apps/some-app/src/main.ts",
            "polyfills": "apps/some-app/src/polyfills.ts",
            "tsConfig": "apps/some-app/tsconfig.app.json",
            "aot": true,
            "assets": [
              "apps/some-app/src/favicon.ico",
              "apps/some-app/src/assets"
            ],
            "styles": [
              "apps/some-app/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "apps/some-app/src/environments/environment.ts",
                  "with": "apps/some-app/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "some-app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "some-app:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "some-app:build"
          }
        }
      }
    },
    "some-app-e2e": {
      "root": "apps/some-app-e2e",
      "sourceRoot": "apps/some-app-e2e/src",
      "projectType": "application",
      "architect": {}
    },
    "go-js-lib": {
      "projectType": "library",
      "root": "libs/go-js-lib",
      "sourceRoot": "libs/go-js-lib/src",
      "prefix": "myworkspace",
      "architect": {},
      "schematics": {}
    }
  },
  "cli": {
    "schematicCollections": [
      "@nx/angular"
    ]
  },
  "schematics": {
    "@nx/angular:application": {
      "unitTestRunner": "jest",
      "e2eTestRunner": "cypress"
    },
    "@nx/angular:library": {
      "unitTestRunner": "jest"
    }
  }
}
